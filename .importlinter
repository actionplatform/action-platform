[importlinter]
root_packages =
    action_platform
    app
include_external_packages = True

[importlinter:contract:api-layers]
name = api: routes → services → repositories → core, never upwards
type = layers
layers =
    app.api
    app.services
    app.repositories
    app.schemas
    app.core

[importlinter:contract:api-routes-only-http]
name = api: only api/routes and api/app import FastAPI routers; schemas and core know no services
type = forbidden
source_modules =
    app.schemas
    app.core
forbidden_modules =
    app.services
    app.repositories
    app.api

[importlinter:contract:contexts-independent]
name = api: app contexts talk to each other only through their package interface
type = independence
modules =
    app.services.releases
    app.services.deployments
    app.services.templates

[importlinter:contract:projects-thin]
name = api: the projects context does not reach into ci or deployments
type = forbidden
source_modules =
    app.services.projects
forbidden_modules =
    app.services.ci
    app.services.deployments

[importlinter:contract:services-no-fastapi]
name = api: services and repositories raise domain errors, not HTTPException
type = forbidden
source_modules =
    app.services
    app.repositories
forbidden_modules =
    fastapi

[importlinter:contract:library-independent]
name = the library never imports the API
type = forbidden
source_modules =
    action_platform
forbidden_modules =
    app

[importlinter:contract:core-protocols]
name = core reaches plugins, mcp, cli and remote only through its ports
type = forbidden
source_modules =
    action_platform.core
forbidden_modules =
    action_platform.plugins
    action_platform.mcp
    action_platform.cli
    action_platform.remote
