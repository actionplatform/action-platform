{
  "name": "action-platform-next",
  "private": true,
  "version": "0.18.6",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "api:types": "cd ../.. && AP_ALLOW_UNAUTHENTICATED=1 AP_DATABASE_URL=sqlite:// poetry run python -c \"import json; from app.api.app import build; json.dump(build().openapi(), open('apps/web/openapi.json','w'))\" && cd apps/web && openapi-typescript openapi.json -o lib/api.d.ts && node scripts/strip-comments.mjs lib/api.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.74.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "^15.3.0",
    "openapi-fetch": "^0.17.0",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.30.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
