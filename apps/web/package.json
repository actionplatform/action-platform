{
  "name": "action-platform-next",
  "private": true,
  "version": "0.5.1",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "api:types": "cd ../.. && poetry run python -c \"import json; from action_platform.api.main import build; json.dump(build().openapi(), open('apps/web/openapi.json','w'))\" && cd apps/web && openapi-typescript openapi.json -o lib/api.d.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.pg.config.ts && drizzle-kit generate --config drizzle.mysql.config.ts && drizzle-kit generate --config drizzle.sqlite.config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "mysql2": "^3.24.4",
    "next": "^15.3.0",
    "openapi-fetch": "^0.17.0",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.30.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
