# Written by install.sh; edit and `docker compose up -d` to apply.

# Where browsers reach the platform. http://<ip>:3000 without a domain,
# https://<domain> with one (then run with --profile tls).
PUBLIC_URL=http://127.0.0.1:3000
WEB_PORT=3000
DOMAIN=
ACME_EMAIL=

# Generated by install.sh (openssl rand -hex 32)
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
AP_API_TOKEN=

# Optional: OAuth apps so members can "Connect with …". Also settable in the UI.
# Callback URLs: ${PUBLIC_URL}/api/oauth/github/callback  (gitlab, bitbucket likewise)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Optional: local images instead of the published ones
# AP_IMAGE_API=action-platform-api:local
# AP_IMAGE_WEB=action-platform-web:local

# Optional: only clone from these git hosts (comma-separated, subdomains included). Empty = any https host.
ACTION_PLATFORM_GIT_HOSTS=
