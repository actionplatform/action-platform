# Python API: the core (git, releases, deploys) behind the web app.
FROM python:3.12-slim

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends git curl ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY pyproject.toml poetry.lock README.md LICENSE ./
COPY action_platform ./action_platform
RUN pip install --no-cache-dir ".[api]"

# Registry, workspaces (app clones) and credentials live here: mount it.
ENV AP_HOME=/data
VOLUME /data
WORKDIR /data

EXPOSE 7788
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fs http://127.0.0.1:7788/api/version || exit 1
CMD ["action-platform", "api", "--host", "0.0.0.0", "--port", "7788", "--cors", ""]
