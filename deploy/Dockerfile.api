# Two images from one file: `api` (target api) serves HTTP with Python and git only;
# `worker` (target worker) adds the toolchains the deploy targets build with.
FROM golang:1.23-bookworm@sha256:167053a2bb901972bf2c1611f8f52c44d5fe7e762e5cab213708d82c421614db AS go
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS node
FROM ruby:3.3-slim-bookworm@sha256:c7ea4b75f15a694054ce0ca7a42e9ce511115f7099d7c2f4381fccaa36c64c46 AS ruby

FROM python:3.12-slim@sha256:b699c2a51f4f834fa1a5f7f7cba0356e71d82fae37d4628223b11d93b71e9ebe AS base

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends git curl ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r -g 10001 app && useradd -r -u 10001 -g app -m -d /home/app -s /usr/sbin/nologin app

WORKDIR /src
COPY pyproject.toml poetry.lock README.md LICENSE ./
COPY action_platform ./action_platform
RUN pip install --no-cache-dir --no-deps .
COPY apps/api/pyproject.toml apps/api/poetry.lock ./apps/api/
RUN pip install --no-cache-dir "poetry>=1.8" poetry-plugin-export \
 && cd apps/api && poetry export --only main -f requirements.txt -o /tmp/requirements.txt \
 && grep -Ev "^(-e )?(action-platform|file://)" /tmp/requirements.txt > /tmp/requirements.pinned.txt \
 && pip install --no-cache-dir --require-hashes -r /tmp/requirements.pinned.txt
COPY apps/api ./apps/api
RUN pip install --no-cache-dir --no-deps ./apps/api

WORKDIR /srv
RUN chown app:app /srv
ENV HOME=/home/app

FROM base AS api

USER app
EXPOSE 7788
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fs http://127.0.0.1:7788/api/version || exit 1
CMD ["action-platform-api", "serve", "--host", "0.0.0.0", "--port", "7788", "--cors", ""]

FROM base AS worker

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends make zip build-essential pkg-config \
      openjdk-21-jdk-headless maven libyaml-dev libgmp-dev libssl-dev libffi-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

COPY --from=go /usr/local/go /usr/local/go
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=ruby /usr/local/bin/ruby /usr/local/bin/gem /usr/local/bin/bundle /usr/local/bin/bundler /usr/local/bin/
COPY --from=ruby /usr/local/lib/ruby /usr/local/lib/ruby
COPY --from=ruby /usr/local/lib/libruby.so* /usr/local/lib/
COPY --from=ruby /usr/local/include/ruby-3.3.0 /usr/local/include/ruby-3.3.0
COPY --from=ruby /usr/local/lib/pkgconfig /usr/local/lib/pkgconfig
COPY --from=ruby /usr/local/bundle /usr/local/bundle
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ldconfig

RUN pip install --no-cache-dir "poetry>=1.8" poetry-plugin-export \
      "ap-build @ git+https://github.com/actionplatform/images-base@v0.1.0" \
 && chown -R app:app /usr/local/bundle

ENV PATH=/usr/local/go/bin:/home/app/go/bin:$PATH \
    GOPATH=/home/app/go \
    GEM_HOME=/usr/local/bundle \
    BUNDLE_SILENCE_ROOT_WARNING=1

USER app
CMD ["action-platform-api", "worker"]
